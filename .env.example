# Airwallex payment credentials — set these in Netlify (Site settings > Environment
# variables), NOT in the repo. This file is only a template for local `netlify dev`.
#
# Find these in the Airwallex webapp: Account settings > Developer > API keys.
# Use DEMO/sandbox keys while testing; switch to LIVE keys + AIRWALLEX_ENV=prod
# only when you are ready to take real payments.

AIRWALLEX_CLIENT_ID=your-airwallex-client-id
AIRWALLEX_API_KEY=your-airwallex-api-key
AIRWALLEX_ENV=demo
